# ── Django ────────────────────────────────────────────────────
DJANGO_SECRET_KEY=your-secret-key-min-50-chars-change-in-production!!
DEBUG=True
ALLOWED_HOSTS=*
DJANGO_SETTINGS_MODULE=docconnect_backend.settings.development

# ── Database ──────────────────────────────────────────────────
DB_NAME=docconnect_db
DB_USER=docconnect_user
DB_PASSWORD=docconnect_password
DB_HOST=localhost
DB_PORT=5432

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET_KEY=your-jwt-secret-min-32-chars-change-me!!
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

# ── AWS S3 ────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=<your-aws-access-key>
AWS_SECRET_ACCESS_KEY=<your-aws-secret-key>
AWS_STORAGE_BUCKET_NAME=docconnect-media
AWS_S3_REGION_NAME=ap-south-1
AWS_S3_CUSTOM_DOMAIN=

# ── SMS ───────────────────────────────────────────────────────
SMS_PROVIDER=msg91
SMS_API_KEY=<your-sms-api-key>
SMS_SENDER_ID=DOCCON
SMS_OTP_TEMPLATE_ID=<your-template-id>

# ── Firebase FCM ──────────────────────────────────────────────
FCM_SERVER_KEY=<your-fcm-server-key>

# ── Email ─────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=<your-email>
EMAIL_HOST_PASSWORD=<your-app-password>
DEFAULT_FROM_EMAIL=noreply@docconnect.com

# ── Sentry ────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ── NMC API ───────────────────────────────────────────────────
NMC_API_BASE_URL=https://api.nmc.org.in
NMC_API_KEY=<your-nmc-api-key>

# ── CORS ──────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
